cc --version | head -n 1
cc -print-search-dirs
cc -print-prog-name=cc1
ls -l /usr/libexec/gcc/x86_64-unknown-linux-musl/16.2.0/cc1
/usr/libexec/gcc/x86_64-unknown-linux-musl/16.2.0/cc1 --version
echo cc1-status=$?
printf '%s\n' '#include <stdio.h>' 'int main(void) { puts("compile-run-ok"); return 0; }' > /tmp/hello.c
printf 'all:\n\t@echo make-ok\n' > /tmp/Makefile
git --version
curl --version | head -n 1
if cc /tmp/hello.c -o /tmp/hello && /tmp/hello && make -f /tmp/Makefile; then
    echo DEVELOPMENT_SMOKE_GREEN
else
    echo DEVELOPMENT_SMOKE_RED
fi
