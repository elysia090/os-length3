#!/bin/sh
set -eu
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
trap 'echo "Boot root handoff failed." >&2' EXIT

/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mkdir -p /run /newroot
/bin/busybox mount -t tmpfs -o mode=0755,size=50% tmpfs /run
/bin/busybox mkdir -p /run/release /run/cow/upper /run/cow/work

# The adapter supplies only an immutable block device. Linux owns the entire
# installed filesystem and copies up only objects actually modified. Neither
# a partial /usr bind nor a writable copy of the release is another root.
/bin/busybox mount -t squashfs -o ro /dev/mtdblock0 /run/release
test -s /run/release/lib/apk/db/installed
test -x /run/release/usr/libexec/system/init
# Persistent storage is a guest block device, never a host pathname adapter.
# Only an explicitly authenticated new volume permits formatting. A missing
# or corrupt restored filesystem fails closed instead of silently becoming
# an empty workspace. Native boot without this device retains its RAM upper.
if test -b /dev/vda; then
    case " $(cat /proc/cmdline) " in
      *' length3.workspace=new '*)
        /run/release/usr/bin/mke2fs -t ext4 -F -m 0 /dev/vda ;;
    esac
    /bin/busybox mkdir -p /run/workspace
    /bin/busybox mount -t ext4 /dev/vda /run/workspace
    /bin/busybox mkdir -p /run/workspace/upper /run/workspace/work
    /bin/busybox mount --bind /run/workspace /run/cow
fi
/bin/busybox mount -t overlay \
    -o lowerdir=/run/release,upperdir=/run/cow/upper,workdir=/run/cow/work \
    overlay /newroot
/bin/busybox mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
for fs in dev proc sys run; do
    /bin/busybox mount --move /"$fs" /newroot/"$fs"
done

# switch_root drops the early archive; all subsequent execs use the installed
# release. The OverlayFS backing mounts move with /run and remain inspectable.
exec /bin/busybox switch_root -c /dev/console /newroot /usr/libexec/system/init
