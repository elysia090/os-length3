#!/bin/sh

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true

# The immutable development system is a reserved physical-memory device.
# Linux mounts it itself, so pathname lookup, page cache and permissions have
# exactly the same semantics as every other guest filesystem.
if ! mount -t squashfs -o ro /dev/mtdblock0 /system; then
    echo "Toolchain mount failed."
    exec /bin/sh
fi
mount -o bind /system/usr /usr
mount -o bind /system/etc/ssl /etc/ssl

uname -sr
echo "BusyBox is ready."
echo "C toolchain is ready."
exec /bin/sh
