{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["why/text", "why/agent", "why/api", "why/repo", "why/home", "why/shipto", "why/prompt", "why/device", "why/cowboy", "why/app", "why/test/app/*.ts", "scripts", "module/sods/runtime", "module/sods/test", "module/muk/make", "module/muk/test", "module/ricebox/make", "module/ricebox/layers", "module/you/make", "module/everyday"]
}
