{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["why/text", "why/agent", "why/api", "why/repo", "why/home", "why/shipto", "why/prompt", "why/device", "why/cowboy", "why/app", "why/test/app/*.ts", "scripts", "ricebox/sods/runtime", "ricebox/sods/test", "ricebox/muk/make", "ricebox/muk/test", "ricebox/distribution/test", "ricebox/distribution/verification", "ricebox/distribution/runtime", "ricebox/distribution/format", "ricebox/distribution/build", "ricebox/distribution/host", "ricebox/distribution/deployment", "ricebox/distribution/integrations", "ricebox/you/make", "ricebox/otter/make", "ricebox/everyday"]
}
