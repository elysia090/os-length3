__pycache__/
*.py[cod]
dist/
node_modules/
/temp/
/.tmp/
/.pytest_cache/
/.uv-cache/
/*.obj

# Secrets never enter history, wherever they are left: environment files (Wrangler's local ones included), private
# keys and certificates' keys, and the Agent's key file should one be copied out of the data directory.
.env
.env.*
.dev.vars
.dev.vars.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
agent-key

# What the build and the tests make (the OS's own: the app, l3 for the browser, the Worker, the selftests' runs).
/target/
/public/l3/
/length3-web.zip
/length3-web.zip.sha256
/.wrangler/
/tests/.dist/
/tests/.logs/
/tests/.results/
/tests/.report/
/tests/.pg/
/src/desktop/binaries/
