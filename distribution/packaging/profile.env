# Sourced by POSIX-adjacent Bash build/check scripts. Keep this file declarative.
DISTRIBUTION_PROFILE_ID=development-standard-v1
DISTRIBUTION_RELEASE_VERSION=0.1.0
DISTRIBUTION_SOURCE_DATE_EPOCH=0
# The VM exposes the authenticated package repository at this guest coordinate;
# no host build path is serialized into the installed root.
DISTRIBUTION_PACKAGE_REPOSITORY=/system/apk/Packages.adb
DISTRIBUTION_PACKAGE_POLICY_SCHEMA=apk-publication-v1
DISTRIBUTION_PACKAGE_SELECTION_POLICY=exact-world-no-automatic-selection
DISTRIBUTION_PACKAGE_LAYER_POLICY=root-only
DISTRIBUTION_PACKAGE_EFFECT_POLICY=forbid
DISTRIBUTION_PACKAGE_LOG_POLICY=omit
DISTRIBUTION_RELEASE_MAX_BYTES=75000000
# block, slice, instruction, immutable-read, archive-member, derived-cell.
# A standard release must present every declared nonempty population to the
# complete Artifact gate; clearing a bit is a profile change, not discovery.
DISTRIBUTION_ARTIFACT_SEMANTIC_FAMILY_MASK=63
DISTRIBUTION_CPU_PROFILE=x86-64-v2
# Next-publication CPU revision. Published v0.1.0-rc.1 receipts retain v1;
# changing this contract does not rewrite that immutable release.
DISTRIBUTION_CPU_CONTRACT=development-standard-v2
DISTRIBUTION_POSTLINK_INPUT_DRIVER_FLAG=-Wl,--emit-relocs
DISTRIBUTION_POSTLINK_INPUT_LINKER_FLAG=--emit-relocs
DISTRIBUTION_OFFLINE_MILESTONE=interactive-ready
DISTRIBUTION_NETWORK_MILESTONE=network-ready
DISTRIBUTION_TIME_MILESTONE=time-synced
DISTRIBUTION_RUNTIME_CLOSURE_MANIFEST=/usr/share/qm/runtime-closure.tsv

# The only retained non-directory paths not owned by a signed package. Their
# bytes are a deterministic projection of the signed index and exact world.
# Locks, logs, caches and extraction scratch are never immutable release state.
DISTRIBUTION_APK_TRANSACTION_PATHS=(
  /etc/apk/arch
  /etc/apk/repositories
  /etc/apk/world
  /lib/apk/db/installed
  /lib/apk/db/scripts.tar.gz
  /lib/apk/db/triggers
  /system/apk/Packages.adb
)

DISTRIBUTION_ELF_INTERPRETERS=(
  /lib/ld-musl-x86_64.so.1
)

# command|absolute path|source package.  This is the provider contract: a
# rescue applet at another path cannot silently stand in for the standard
# package selected by the distribution recipe.
DISTRIBUTION_COMMAND_PROVIDERS=(
  '[|/usr/bin/[|busybox'
  'apk|/usr/bin/apk|apk-tools'
  'ar|/usr/bin/ar|binutils'
  'as|/usr/bin/as|binutils'
  'awk|/usr/bin/awk|busybox'
  'base64|/bin/base64|busybox'
  'blkid|/usr/bin/blkid|util-linux'
  'bridge|/usr/bin/bridge|iproute2'
  'busybox|/bin/busybox|busybox'
  'bzip2|/usr/bin/bzip2|bzip2'
  'cc|/usr/bin/cc|gcc'
  'chronyc|/usr/bin/chronyc|chrony'
  'chronyd|/usr/bin/chronyd|chrony'
  'cmp|/usr/bin/cmp|busybox'
  'cpio|/bin/cpio|busybox'
  'curl|/usr/bin/curl|curl'
  'dhcpcd|/usr/bin/dhcpcd|dhcpcd'
  'diff|/usr/bin/diff|busybox'
  'dmesg|/usr/bin/dmesg|util-linux'
  'e2fsck|/usr/bin/e2fsck|e2fsprogs'
  'fdisk|/usr/bin/fdisk|util-linux'
  'file|/usr/bin/file|file'
  'gcc|/usr/bin/gcc|gcc'
  'getcap|/usr/bin/getcap|libcap'
  'getfacl|/usr/bin/getfacl|acl'
  'getfattr|/usr/bin/getfattr|attr'
  'getopt|/bin/getopt|busybox'
  'git|/usr/bin/git|git'
  'groupadd|/usr/bin/groupadd|shadow'
  'gzip|/usr/bin/gzip|gzip'
  'insmod|/usr/bin/insmod|kmod'
  'install|/usr/bin/install|busybox'
  'ip|/usr/bin/ip|iproute2'
  'ld|/usr/bin/ld|binutils'
  'less|/usr/bin/less|busybox'
  'lsblk|/usr/bin/lsblk|util-linux'
  'lsmod|/usr/bin/lsmod|kmod'
  'make|/usr/bin/make|make'
  'mdevd|/usr/bin/mdevd|mdevd'
  'mdevd-coldplug|/usr/bin/mdevd-coldplug|mdevd'
  'mke2fs|/usr/bin/mke2fs|e2fsprogs'
  'modprobe|/usr/bin/modprobe|kmod'
  'mount|/usr/bin/mount|util-linux'
  'nano|/usr/bin/nano|nano'
  'nft|/usr/bin/nft|nftables'
  'openssl|/usr/bin/openssl|openssl'
  'passwd|/usr/bin/passwd|shadow'
  'patch|/usr/bin/patch|patch'
  'pkg-config|/usr/bin/pkg-config|pkgconf'
  'pkgconf|/usr/bin/pkgconf|pkgconf'
  'ranlib|/usr/bin/ranlib|binutils'
  'resize2fs|/usr/bin/resize2fs|e2fsprogs'
  'rmmod|/usr/bin/rmmod|kmod'
  's6-rc|/usr/bin/s6-rc|s6-rc'
  's6-rc-db|/usr/bin/s6-rc-db|s6-rc'
  's6-rc-init|/usr/bin/s6-rc-init|s6-rc'
  's6-supervise|/usr/bin/s6-supervise|s6'
  's6-svscan|/usr/bin/s6-svscan|s6'
  'scp|/usr/bin/scp|openssh-client'
  'setcap|/usr/bin/setcap|libcap'
  'setfacl|/usr/bin/setfacl|acl'
  'setfattr|/usr/bin/setfattr|attr'
  'sha256sum|/usr/bin/sha256sum|busybox'
  'sftp|/usr/bin/sftp|openssh-client'
  'sh|/bin/sh|busybox'
  'ss|/usr/bin/ss|iproute2'
  'ssh|/usr/bin/ssh|openssh-client'
  'strip|/usr/bin/strip|binutils'
  'stty|/bin/stty|busybox'
  'su|/usr/bin/su|shadow'
  'tar|/usr/bin/tar|tar'
  'tc|/usr/bin/tc|iproute2'
  'test|/usr/bin/test|busybox'
  'timeout|/usr/bin/timeout|busybox'
  'umount|/usr/bin/umount|util-linux'
  'unzip|/usr/bin/unzip|busybox'
  'useradd|/usr/bin/useradd|shadow'
  'userdel|/usr/bin/userdel|shadow'
  'usermod|/usr/bin/usermod|shadow'
  'xz|/usr/bin/xz|xz'
  'zstd|/usr/bin/zstd|zstd'
)

DISTRIBUTION_REQUIRED_PATHS=(
  boot/kernel
  boot/initramfs
  usr/include/stdio.h
  usr/include/linux/version.h
  usr/include/asm/unistd.h
  etc/apk/repositories
  etc/apk/world
  etc/passwd
  etc/group
  etc/hosts
  etc/mdev.conf
  etc/shadow
  etc/gshadow
  system/apk/Packages.adb
  etc/ssl/certs/ca-certificates.crt
  etc/s6-rc/compiled/current
  usr/libexec/system/init
  usr/libexec/system/boot
  usr/libexec/system/console
  usr/libexec/system/halt
  usr/libexec/system/ready
  usr/share/zoneinfo/UTC
  usr/share/misc/magic.mgc
  usr/share/qm/distribution-profile.env
  usr/share/qm/bootstrap-packages.sha256
  usr/share/qm/bootstrap-installed.lock
  usr/share/qm/sources.env
  usr/share/qm/runtime-closure.tsv
)

# Persistent non-command coordinates whose package authority is part of the
# standard profile. Command ownership is declared above. Apk transaction state
# (`world`, installed DB, repositories) is intentionally not package-owned.
DISTRIBUTION_PATH_OWNERS=(
  '/boot/kernel|linux-boot'
  '/boot/initramfs|linux-boot'
  '/etc/nftables.conf|system-config'
  '/etc/ssh/ssh_config|system-config'
  '/etc/passwd|system-config'
  '/etc/group|system-config'
  '/etc/hosts|system-config'
  '/etc/mdev.conf|system-config'
  '/etc/shadow|system-config'
  '/etc/gshadow|system-config'
  '/etc/ssl/certs/ca-certificates.crt|ca-certificates'
  '/etc/s6-rc/compiled/current/db|base-services'
  '/etc/s6-rc/compiled/current/n|base-services'
  '/etc/s6-rc/compiled/current/resolve.cdb|base-services'
  '/usr/include/asm/unistd.h|linux-headers'
  '/usr/include/linux/version.h|linux-headers'
  '/usr/include/stdio.h|musl'
  '/usr/libexec/system/init|base-services'
  '/usr/libexec/system/boot|base-services'
  '/usr/libexec/system/console|base-services'
  '/usr/libexec/system/halt|base-services'
  '/usr/libexec/system/ready|base-services'
  '/usr/share/misc/magic.mgc|file'
  '/usr/share/qm/bootstrap-installed.lock|release-metadata'
  '/usr/share/qm/bootstrap-packages.sha256|release-metadata'
  '/usr/share/qm/distribution-profile.env|release-metadata'
  '/usr/share/qm/runtime-closure.tsv|release-metadata'
  '/usr/share/qm/sources.env|release-metadata'
  '/usr/share/zoneinfo/UTC|tzdata'
  '/var/run|base-services'
)

DISTRIBUTION_FORBIDDEN_NAMES=(
  lto1 lto-wrapper lto-dump liblto_plugin.so liblto_plugin.a
  git-daemon git-http-backend git-imap-send
)

# Commands whose non-ELF runtime lookup surface must have at least one entry in
# the canonical manifest. command_path resolves their installed absolute path.
DISTRIBUTION_DECLARED_RUNTIME_COMMANDS=(
  gcc git curl ssh openssl apk s6-rc
)
