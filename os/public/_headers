# Headers Workers Assets puts on the app's own files (index.html, the hashed
# assets, the userland). The page's whole policy is a header here as well as
# the build's <meta> tag (src/policy.ts, for the build on its own origin; the
# web release's zip, served by any server, has the tag alone), because only a
# header can say frame-ancestors: no other page may frame the app (a framed
# device-approval page could be clicked through by someone who was never
# asked). Reached only by HTTPS; no referrer sent on; no powerful feature but
# passkeys and the clipboard; its files not taken as resources by another
# site; its window not shared with one it opens. headers.test.ts holds these
# to src/policy.ts and OWASP ASVS 14.4; the preview serves them as here.
# COOP and COEP make the page cross-origin isolated, so it may share memory:
# the Prompt runs each guest thread in a Worker of its own over one
# SharedArrayBuffer (xlat/runtime/remote.mjs). It loads nothing from another
# origin but by CORS (the Remote), so require-corp asks nothing more of it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), display-capture=(), publickey-credentials-get=(self), publickey-credentials-create=(self), clipboard-write=(self)

# The hashed files never change under their names (a new build names its own): kept a year, never asked
# again. index.html is not hashed and stays as Workers Assets serves it (asked again each time, by its ETag).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# l3 (scripts/l3.mjs): every file but l3.json is named by its digest, so it never changes under its name and
# is kept a year; the Worker's Range requests into a pack are answered from what the browser has of it.
# l3.json says which l3 this build carries: asked again each time.
/l3/l3.json
  Cache-Control: no-cache
/l3/index-*
  Cache-Control: public, max-age=31536000, immutable
/l3/packs/*
  Cache-Control: public, max-age=31536000, immutable
/l3/blobs/*
  Cache-Control: public, max-age=31536000, immutable
