CONFIG_DIFF=y
CONFIG_ED=y
CONFIG_FIND=y
CONFIG_SED=y
CONFIG_VI=y
CONFIG_XARGS=y
CONFIG_WHICH=y

# Archives the root has no package of its own for.
CONFIG_CPIO=y
CONFIG_UNZIP=y

# Reading bytes and pages, numbers, time.
CONFIG_ASCII=y
CONFIG_BC=y
CONFIG_CAL=y
CONFIG_DC=y
CONFIG_HD=y
CONFIG_HEXDUMP=y
CONFIG_HEXEDIT=y
CONFIG_MORE=y
CONFIG_REV=y
CONFIG_TIME=y
CONFIG_TREE=y
CONFIG_TS=y
CONFIG_XXD=y

# The terminal.
CONFIG_RESIZE=y
CONFIG_SCRIPT=y
CONFIG_SCRIPTREPLAY=y
CONFIG_TTYSIZE=y

# Processes, and what they run in.
CONFIG_CHRT=y
CONFIG_FALLOCATE=y
CONFIG_FLOCK=y
CONFIG_FREE=y
CONFIG_FUSER=y
CONFIG_GETOPT=y
CONFIG_IONICE=y
CONFIG_IOSTAT=y
