# BusyBox as the root has it: the shell (ash) and the tools a shell's work reaches for, each an applet of one static
# program, each whole: what BusyBox's own defconfig gives an applet (long options, sort keys, find's tests and
# -exec, grep's context, head -N, ls's colours and the rest), save where this says otherwise and why. busybox.sh
# starts from defconfig, turns every applet off, then gives these lines: the applets named here are the ones made,
# and it stops if one of them is not.
#
# Not here, by what they are:
# - What a package of the root has whole: tar, patch and grep (GNU's, grep with egrep and fgrep), less, gzip,
#   bzip2 and xz and their other names, util-linux's mount, umount, dmesg, blkid and fdisk, iproute2's ip and tc,
#   ncurses's clear and reset, binutils's strings, attr's setfattr.
# - wget and its ssl_client: BusyBox's TLS does not check a server's certificate. curl does, and is the root's.
# - What only a machine that boots has: init and halting, the module tools, mdev, consoles and keymaps, disks and
#   their file systems, swap, the clock, a network's configuration and DHCP, the kernel's settings, a system log.
#   A Prompt runs on the app's kernel, in the namespaces it makes, and none of that is its.
# - Servers and what runs on a schedule (httpd, telnetd, ftpd, tftpd, inetd, ntpd, crond, runit,
#   start-stop-daemon): a Prompt listens for no one, and runs nothing when no one is there.
# - Logins and accounts (login, getty, su, passwd, adduser and the rest, who, w, last, wall, mesg): the root's
#   accounts are its settings (system-config), and no one logs in to it.
# - Another system's packages (dpkg, rpm), mail, printing, and man (the root keeps no manuals); hush (ash is the
#   shell); setarch and linux32 (the root has no 32-bit programs).

# How it is built: static, with the flags every program of the root is, its links in bin/ and sbin/ beside it
# (INSTALL_NO_USR: each `busybox` or `../bin/busybox` wherever /usr is).
CONFIG_STATIC=y
CONFIG_INSTALL_NO_USR=y
CONFIG_EXTRA_CFLAGS=""
CONFIG_EXTRA_LDFLAGS="-Wl,-z,relro,-z,now,-z,noexecstack"

# Where it departs from defconfig.
# No applet is setuid, and none takes a privilege from its file (the root has no setuid programs).
CONFIG_FEATURE_SUID=n
# No one logs in, so nothing keeps utmp or wtmp.
CONFIG_FEATURE_UTMP=n
# The shell's history is the Prompt's (the app keeps it), not a file in /root.
CONFIG_FEATURE_EDITING_SAVEHISTORY=n
# A line as long as a pasted command.
CONFIG_FEATURE_EDITING_MAX_LEN=4096
# Every printable character shown as itself, wide ones (Japanese, emoji) and combining ones too: BusyBox's own
# default takes what is past U+02FF for unprintable and writes ? in its place.
CONFIG_LAST_SUPPORTED_WCHAR=0
CONFIG_UNICODE_COMBINING_WCHARS=y
CONFIG_UNICODE_WIDE_WCHARS=y
# No mail comes to a Prompt.
CONFIG_ASH_MAIL=n
# sleep is the applet, run apart from the shell, not ash's builtin: the builtin stops at the first signal the shell
# handles (BusyBox's sleep does not go on after one, so that a trap runs at once), and the shell handles SIGCHLD,
# which every job of its own that ends sends: `make & sleep 10` slept until make was done, and a Prompt's line ended
# its sleep when its prompt line's own subshells were reaped.
CONFIG_ASH_SLEEP=n

# The shell.
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y

# Files, text, and the shell's own words.
CONFIG_BASE32=y
CONFIG_BASE64=y
CONFIG_BASENAME=y
CONFIG_BB_ARCH=y
CONFIG_CAT=y
