# The Prompt's shell, as the app shows it: the open repo is the place you are
# in (/root/<repo>), what you change there is written back and sent to the
# Remote by the app, and l3 speaks the app's words (`l3 help`).
case $- in *i*) ;; *) return 0 2>/dev/null ;; esac

# Where you are, as File shows it: the repo and the folder in it, else the path.
__l3_where() {
  case $PWD in
    "/root/$LENGTH3_REPO") printf '%s' "$LENGTH3_REPO" ;;
    "/root/$LENGTH3_REPO"/*) printf '%s' "$LENGTH3_REPO${PWD#/root/$LENGTH3_REPO}" ;;
    *) printf '%s' "$PWD" ;;
  esac
}
# How the line run before ended, told the app as terminals' shell integration tells it (OSC 133 D, with its exit
# status), before each prompt line: the app reads it (a run that failed says so, and its Agent knows how a build
# or the tests went) and shows none of it.
__l3_ran() { printf '\033]133;D;%s\007' "$1"; }
PS1='$(__l3_ran $?)$(__l3_where) $ '
alias ll='ls -l'

# What programs keep of a person's work from one Prompt to the next. /root is made new for each Prompt, and its
# .cache is the repo's own, kept between them (and freed when room is wanted): so what zoxide learns of the places
# you go, the .envrc files direnv was told to trust, where nano left each file and what less was asked to find are
# kept there.
export XDG_DATA_HOME="${XDG_DATA_HOME:-/root/.cache/share}" XDG_STATE_HOME="${XDG_STATE_HOME:-/root/.cache/state}"
# (made here: nano makes only the last directory of where it keeps them, and says so at every start otherwise)
[ -d "$XDG_DATA_HOME" ] && [ -d "$XDG_STATE_HOME" ] || mkdir -p "$XDG_DATA_HOME" "$XDG_STATE_HOME" 2>/dev/null
# Each tool's settings where the root keeps them: ripgrep's (smart case), tldr's (its pages offline, in the
# person's language first), and fzf's list of files as fd finds them (what .gitignore leaves out, left out).
export RIPGREP_CONFIG_PATH=/etc/ripgreprc TEALDEER_CONFIG_DIR=/etc/tealdeer FZF_DEFAULT_COMMAND='fd --type f'
[ "$LENGTH3_LANG" != ja ] || export LANGUAGE=ja

# Moving to a directory: zoxide learns it (z goes back to it by a part of its name: `z web` for /root/web-42/src),
# and direnv loads its .envrc and unloads the one left, where one has been allowed (direnv allow). In ash, which has
# no hook run before each prompt, both follow cd and z. Neither keeps cd waiting: zoxide learns on its own time, and
# direnv is asked only where it has something to do (an .envrc here or above, or one loaded to be left).
. /usr/share/zoxide/init.sh
# (Without a hook, zoxide's setup leaves out the check its z calls first: there is nothing for it to check.)
__zoxide_doctor() { :; }
__l3_envrc() {
  [ -z "${DIRENV_DIR:-}" ] || return 0
  __l3_d=$PWD
  while :; do
    [ ! -e "${__l3_d%/}/.envrc" ] || return 0
    [ -n "$__l3_d" ] && [ "$__l3_d" != / ] || return 1
    __l3_d=${__l3_d%/*}
  done
}
# zoxide learns a place by reading what it knows and writing it all again, with nothing to keep two from writing at
# once: of two learnt together (cd a && cd b) the one written last is all that is kept. They learn one at a time,
# under a lock beside what they keep (where the system has no locks to give, flock says so, and it learns without).
__l3_learn() { flock "$XDG_DATA_HOME/zoxide.lock" zoxide add -- "$1" || command zoxide add -- "$1"; }
__l3_moved() {
  (__l3_learn "$PWD" > /dev/null 2>&1 &)
  if __l3_envrc; then eval "$(command direnv export bash)"; fi
}
cd() { command cd "$@" && __l3_moved; }
z() { __zoxide_z "$@" && __l3_moved; }
zi() { __zoxide_zi "$@" && __l3_moved; }
direnv() {
  command direnv "$@"
  set -- $? "${1:-}"
  case $2 in allow|permit|grant|deny|revoke|disallow|block|reload) __l3_moved ;; esac
  return "$1"
}
__l3_moved

# The repo's history is the Remote's: git has nothing to say inside it, so it says where to go.
git() {
  case $PWD/ in
    "/root/$LENGTH3_REPO"/*)
      if ! command git rev-parse --git-dir >/dev/null 2>&1; then
        if [ "$LENGTH3_LANG" = ja ]; then
          echo "git: $LENGTH3_REPO の履歴は Remote にあります。Commit・Push・Change はアプリの Git から（l3 git $LENGTH3_REPO で Issue を見られます）" >&2
        else
          echo "git: $LENGTH3_REPO's history is kept on the Remote. Commit, Push and Change it from the app's Git page (l3 git $LENGTH3_REPO lists its issues)." >&2
        fi
        return 1
      fi ;;
  esac
  command git "$@"
}

# The app's Prompt shows what a run says and is no screen to draw on (TERM=dumb), and what is typed into it is
# sent a line at a time. A pager there has nothing to page on and would wait for keys no one is asked for: it shows
# what it was given, whole (git's log and diff too, through PAGER). What draws on a screen says where it can: a
# file is edited in Forge, and a terminal of your own reaches this Prompt over SSH (l3 address). Over SSH, TERM is
# that terminal's, and all of them are themselves.
if [ "$TERM" != dumb ]; then
  # On a terminal, what opens an editor (git commit) opens the root's whole one. In the app's Prompt none is set,
  # so git asks for -m rather than draw on a screen that is not there.
  export EDITOR=nano VISUAL=nano
else
  # git's own diffs here, not delta's (core.pager): delta shows what was added and removed by colour alone, and the
  # Prompt shows text.
  export PAGER=cat GIT_PAGER=cat
  __l3_whole() {
    while [ $# -gt 0 ]; do case $1 in --) shift; break ;; -*) shift ;; *) break ;; esac; done
    cat "$@"
  }
  less() { __l3_whole "$@"; }
  more() { __l3_whole "$@"; }
  __l3_screen() {
    if [ "$LENGTH3_LANG" = ja ]; then
      echo "$1 は画面に描くプログラムで、アプリの Prompt は出力を見せるだけです。ファイルは Forge で編集でき、自分の端末からは SSH でこの Prompt に入れます（l3 address）" >&2
    else
      echo "$1 draws on a screen, and the app's Prompt shows output only: edit files in Forge, or reach this Prompt from a terminal of your own over SSH (l3 address)." >&2
    fi
    return 1
  }
  nano() { __l3_screen nano; }
  vi() { __l3_screen vi; }
  top() { __l3_screen top; }
  watch() { __l3_screen watch; }
  hexedit() { __l3_screen hexedit; }
  cfdisk() { __l3_screen cfdisk; }
  # Those that draw on a screen unless asked only what they are, or to write where no screen is: fzf as a filter
  # (--filter), ncdu's export (-o), a tmux session started detached (-d) or a tmux command that is not a session's.
  __l3_asked() { for a; do case $a in -h|--help|-V|--version|-v) return 0 ;; esac; done; return 1; }
  htop() { if __l3_asked "$@"; then command htop "$@"; else __l3_screen htop; fi; }
  lazygit() { if __l3_asked "$@"; then command lazygit "$@"; else __l3_screen lazygit; fi; }
  fzf() {
    for a; do case $a in -f*|--filter|--filter=*) command fzf "$@"; return ;; esac; done
    if __l3_asked "$@"; then command fzf "$@"; else __l3_screen fzf; fi
  }
  ncdu() {
    for a; do case $a in -o*) command ncdu "$@"; return ;; esac; done
    if __l3_asked "$@"; then command ncdu "$@"; else __l3_screen ncdu; fi
  }
  tmux() {
    for a; do case $a in -d|-V) command tmux "$@"; return ;; esac; done
    case ${1:-new} in new*|a|at|att*) __l3_screen tmux ;; *) command tmux "$@" ;; esac
  }
  zi() { __l3_screen zi; }
fi

# What a person reaches for and the root does not keep says so, and what is there instead: the root has no manuals
# (each program says how it is used, with --help), and its packages are its release's (apk info lists them): none
# is added in a Prompt, whose root is read-only.
man() {
  if [ "$LENGTH3_LANG" = ja ]; then echo "man: この root はマニュアルを持ちません。使い方は ${1:-プログラム} --help が、よくある使い方の例は tldr ${1:-プログラム} が言います" >&2
  else echo "man: the root keeps no manuals; ${1:-a program} --help says how it is used, and tldr ${1:-program} shows its common uses." >&2; fi
  return 1
}
apk() {
  case $1 in
    add|del|fix|upgrade|update|cache)
      if [ "$LENGTH3_LANG" = ja ]; then echo "apk: この root のパッケージはリリースのもので、Prompt の中では足せません（root は読み取り専用）。あるものは apk info で" >&2
      else echo "apk: the root's packages are its release's, and none is added in a Prompt (its root is read-only); apk info lists them." >&2; fi
      return 1 ;;
  esac
  command apk "$@"
}
