{
  "name": "length3-os-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native work OS shell for Length³ OS: purpose rail, target column, central flow and right pane.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cloudflare": ". scripts/rust.sh && node scripts/prompt-files.mjs && VITE_LENGTH3_REMOTE= npm run build",
    "check": "tsc --noEmit && npm test",
    "test": "node --test --import ./src/testing-core.ts \"src/**/*.test.ts\" \"service/*.test.ts\" \"scripts/*.test.mjs\"",
    "selftest:l3": "tsc -p selftest/l3 && node --test \"selftest/l3/*.test.ts\"",
    "selftest": "playwright test -c selftest",
    "selftest:prod": "node selftest/prod/run.ts",
    "verify:remote": "node service/verify.ts",
    "tauri": "tauri",
    "l3": "sh scripts/l3.sh",
    "l3:parity": "node scripts/l3-parity.mjs",
    "web-release": "sh scripts/web-release.sh"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.145.0"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.10",
    "@neondatabase/serverless": "^1.2.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tauri-apps/api": "^2.12.4",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13"
  }
}
