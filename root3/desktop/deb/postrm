#!/bin/sh
# Removed (not upgraded): the profile postinst put in place goes, unloaded first.
set -e
if { [ "$1" = remove ] || [ "$1" = purge ]; } && [ -e /etc/apparmor.d/root3 ]; then
  if command -v apparmor_parser > /dev/null 2>&1; then apparmor_parser -R /etc/apparmor.d/root3 2> /dev/null || true; fi
  rm -f /etc/apparmor.d/root3
fi
exit 0
