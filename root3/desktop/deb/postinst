#!/bin/sh
# Where AppArmor keeps user namespaces from unprivileged programs (Ubuntu 23.10 and later), the profile that lets
# root3 make its Prompts' (deb/root3.apparmor) is put in place and loaded; elsewhere nothing is changed.
set -e
if [ "$1" = configure ] && [ -e /proc/sys/kernel/apparmor_restrict_unprivileged_userns ] && [ -d /etc/apparmor.d ]; then
  install -m 0644 /usr/share/root3/apparmor/root3 /etc/apparmor.d/root3
  if command -v apparmor_parser > /dev/null 2>&1; then apparmor_parser -r -T -W /etc/apparmor.d/root3 || true; fi
fi
exit 0
