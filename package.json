{
  "name": "why",
  "version": "0.0.1",
  "private": true,
  "description": "Native work OS shell for Length\u00b3 OS: purpose rail, target column, central flow and right pane.",
  "type": "module",
  "scripts": {
    "dev": "vite --config why/app/vite.config.ts",
    "build": "tsc --noEmit && vite build --config why/app/vite.config.ts",
    "build:cloudflare": ". why/build/rust.sh && node why/build/fetch-webroot.ts && VITE_LENGTH3_REMOTE= npm run build",
    "check": "tsc --noEmit && npm test",
    "test": "node scripts/tests.ts",
    "selftest:cli": "tsc -p why/test/cli && node --test \"why/test/cli/*.test.ts\"",
    "selftest": "playwright test -c why/test/app",
    "selftest:prod": "node why/test/prod/run.ts",
    "verify:remote": "node why/shipto/remote/db/verify.ts",
    "deploy:cloudflare": "node why/shipto/remote/ship/deploy.ts",
    "tauri": "tauri",
    "webroot": "sh why/build/webroot.sh",
    "webroot:parity": "node ricebox/distribution/verification/distribution.ts",
    "web-release": "sh why/build/web-release.sh"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.25",
    "@neondatabase/serverless": "^1.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tauri-apps/api": "^2.12.4",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
