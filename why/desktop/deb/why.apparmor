# muk makes the user namespace a Prompt's box is in (module/muk; why runs it: why/core/src/prompt/start.rs), which
# AppArmor keeps from unprivileged programs on Ubuntu 23.10 and later unless a profile lets them. This one lets
# /usr/bin/muk make them and changes nothing else: muk is not confined by it, and why, which makes none, has no
# profile. Put in place by the .deb's postinst only where the kernel has that restriction (deb/postinst).
abi <abi/4.0>,
include <tunables/global>

profile muk /usr/bin/muk flags=(unconfined) {
  userns,

  include if exists <local/muk>
}
