# why makes the user namespaces its Prompts run in (why/core/src/prompt/launch.rs), which AppArmor keeps from unprivileged
# programs on Ubuntu 23.10 and later unless a profile lets them. This one lets /usr/bin/why make them and changes
# nothing else: why is not confined by it. Put in place by the .deb's postinst only where the kernel has that
# restriction (deb/postinst).
abi <abi/4.0>,
include <tunables/global>

profile why /usr/bin/why flags=(unconfined) {
  userns,

  include if exists <local/why>
}
