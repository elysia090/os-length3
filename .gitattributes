# Unified patch context records an empty line with a single leading space.
os/root/packages/**/*.patch whitespace=-blank-at-eol
# bash's and readline's own patches, kept as their makers publish them (context diffs, whitespace and all).
os/root/packages/bash/bash53-* whitespace=-blank-at-eol,-trailing-space,-space-before-tab
os/root/packages/readline/readline83-* whitespace=-blank-at-eol,-trailing-space,-space-before-tab
# Debian's patch series to Info-ZIP's Zip, kept as Debian publishes it.
os/root/packages/zip/*.patch whitespace=-blank-at-eol,-trailing-space,-space-before-tab
