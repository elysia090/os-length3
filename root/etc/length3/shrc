# The Prompt's shell, as the app shows it: the open repo is the place you are
# in (/root/<repo>), what you change there is written back and sent to the
# Remote by the app, and root3 speaks the app's words (`root3 help`).
case $- in *i*) ;; *) return 0 2>/dev/null ;; esac

# How the line run before ended, told the app as terminals' shell integration tells it (OSC 133 D, with its exit
# status), before each prompt line: the app reads it (a run that failed says so, and its Agent knows how a build
# or the tests went) and shows none of it. Then where you are, as any shell says it: the whole path, then $. The
# prompt line is read again each time it is shown, and starts no shell for it (a subshell is a process of its own
# each time, and in the browser a costly one, which the app's Prompt was seen waiting on): $? and $PWD are read as
# it is shown.
PS1=$'\033]133;D;''$?'$'\a''$PWD $ '
alias ll='ls -l'

# What programs keep of a person's work from one Prompt to the next. /root is made new for each Prompt, and its
# .cache is the repo's own, kept between them (and freed when room is wanted): so what you learns of the places you
# go, the .envrc files direnv was told to trust, where nano left each file and what less was asked to find are kept
# there.
export XDG_DATA_HOME="${XDG_DATA_HOME:-/root/.cache/share}" XDG_STATE_HOME="${XDG_STATE_HOME:-/root/.cache/state}"
# (made here: nano makes only the last directory of where it keeps them, and says so at every start otherwise)
[ -d "$XDG_DATA_HOME" ] && [ -d "$XDG_STATE_HOME" ] || mkdir -p "$XDG_DATA_HOME" "$XDG_STATE_HOME" 2>/dev/null
# Each tool's settings where the root keeps them: ripgrep's (smart case), tldr's (its pages offline, in the
# person's language first), and fzf's list of files as fd finds them (what .gitignore leaves out, left out).
export RIPGREP_CONFIG_PATH=/etc/ripgreprc TEALDEER_CONFIG_DIR=/etc/tealdeer FZF_DEFAULT_COMMAND='fd --type f'
[ "$LENGTH3_LANG" != ja ] || export LANGUAGE=ja

# Moving to a directory: you learns it (z goes back to it by a part of its name: `z web` for /root/web-42/src), and
# direnv loads its .envrc and unloads the one left, where one has been allowed (direnv allow). In ash, which has no
# hook run before each prompt, both follow cd and z. Neither keeps cd waiting: you learns a place in five calls and
# reads nothing (/usr/bin/you, made for this: tool/you), and direnv is asked only where it has something to do (an
# .envrc here or above, or one loaded to be left), which the shell finds out itself, as it does whether git has a
# repository here: a program started for it is one more each time, and in the browser a costly one.
# Whether NAME is in this folder or one above it, up to STOP (else /).
__root3_above() {
  __root3_d=$PWD
  while :; do
    [ ! -e "${__root3_d%/}/$1" ] || return 0
    [ -n "$__root3_d" ] && [ "$__root3_d" != "${2:-/}" ] && [ "$__root3_d" != / ] || return 1
    __root3_d=${__root3_d%/*}
  done
}
__root3_direnv() { if [ -n "${DIRENV_DIR:-}" ] || __root3_above .envrc; then eval "$(command direnv export bash)"; fi; }
__root3_moved() {
  command you add -- "$PWD" 2> /dev/null
  __root3_direnv
}
cd() { command cd "$@" && __root3_moved; }
# z goes home with nothing, back with -, into a directory named as it is, else to the place most yours its words name
# (you query, not the one you are in); zi, to one picked from all of them (fzf), the most yours first.
z() {
  if [ $# -eq 0 ]; then cd ~
  elif [ $# -eq 1 ] && [ "$1" = - ]; then [ -n "${OLDPWD:-}" ] && cd "$OLDPWD"
  elif [ $# -eq 1 ] && [ -d "$1" ]; then cd "$1"
  else __root3_to=$(command you query --exclude "$PWD" -- "$@") && cd "$__root3_to"
  fi
}
zi() { __root3_to=$(command you query --list -- "$@" | command fzf --height=45% --layout=reverse --no-sort --select-1 --exit-0) && cd "$__root3_to"; }
direnv() {
  command direnv "$@"
  set -- $? "${1:-}"
  case $2 in allow|permit|grant|deny|revoke|disallow|block|reload) __root3_direnv ;; esac
  return "$1"
}
# Started in its repo: what direnv was told to trust there is loaded. you learns the repo when you come back to it, not
# as each Prompt starts (a process of its own, every start, for a place you are already in).
__root3_direnv

# The repo's history is the Remote's: git has nothing to say inside it, so it says where to go (unless a repository
# of git's own is there: a .git in this folder or one above it in the repo, or GIT_DIR).
git() {
  case $PWD/ in
    "/root/$LENGTH3_REPO"/*)
      if [ -z "${GIT_DIR:-}" ] && ! __root3_above .git "/root/$LENGTH3_REPO"; then
        if [ "$LENGTH3_LANG" = ja ]; then
          echo "git: $LENGTH3_REPO の履歴は Remote にあります。Commit・Push・Change はアプリの Git から（root3 git $LENGTH3_REPO で Issue を見られます）" >&2
        else
          echo "git: $LENGTH3_REPO's history is kept on the Remote. Commit, Push and Change it from the app's Git page (root3 git $LENGTH3_REPO lists its issues)." >&2
        fi
        return 1
      fi ;;
  esac
  command git "$@"
}

# The app's Prompt shows what a run says and is no screen to draw on (TERM=dumb), and what is typed into it is
# sent a line at a time. A pager there has nothing to page on and would wait for keys no one is asked for: it shows
# what it was given, whole (git's log and diff too, through PAGER). What draws on a screen says where it can: a
# file is edited in Forge, and a terminal of your own reaches this Prompt over SSH (root3 address). Over SSH, TERM is
# that terminal's, and all of them are themselves.
if [ "$TERM" != dumb ]; then
  # On a terminal, what opens an editor (git commit) opens the root's whole one. In the app's Prompt none is set,
  # so git asks for -m rather than draw on a screen that is not there.
  export EDITOR=nano VISUAL=nano
else
  # git's own diffs here, not delta's (core.pager): delta shows what was added and removed by colour alone, and the
  # Prompt shows text.
  export PAGER=cat GIT_PAGER=cat
  __root3_whole() {
    while [ $# -gt 0 ]; do case $1 in --) shift; break ;; -*) shift ;; *) break ;; esac; done
    cat "$@"
  }
  less() { __root3_whole "$@"; }
  more() { __root3_whole "$@"; }
  # The Prompt clears what it shows when told as a terminal is (ESC [ H ESC [ 2 J); clear asks terminfo how, and a
  # dumb terminal there has no way to, so it would say nothing.
  clear() { printf '\033[H\033[2J'; }
  __root3_screen() {
    if [ "$LENGTH3_LANG" = ja ]; then
      echo "$1 は画面に描くプログラムで、アプリの Prompt は出力を見せるだけです。ファイルは Forge で編集でき、自分の端末からは SSH でこの Prompt に入れます（root3 address）" >&2
    else
      echo "$1 draws on a screen, and the app's Prompt shows output only: edit files in Forge, or reach this Prompt from a terminal of your own over SSH (root3 address)." >&2
    fi
    return 1
  }
  nano() { __root3_screen nano; }
  vi() { __root3_screen vi; }
  top() { __root3_screen top; }
  watch() { __root3_screen watch; }
  hexedit() { __root3_screen hexedit; }
  cfdisk() { __root3_screen cfdisk; }
  # Those that draw on a screen unless asked only what they are, or to write where no screen is: fzf as a filter
  # (--filter), ncdu's export (-o), a tmux session started detached (-d) or a tmux command that is not a session's.
  __root3_asked() { for a; do case $a in -h|--help|-V|--version|-v) return 0 ;; esac; done; return 1; }
  htop() { if __root3_asked "$@"; then command htop "$@"; else __root3_screen htop; fi; }
  lazygit() { if __root3_asked "$@"; then command lazygit "$@"; else __root3_screen lazygit; fi; }
  fzf() {
    for a; do case $a in -f*|--filter|--filter=*) command fzf "$@"; return ;; esac; done
    if __root3_asked "$@"; then command fzf "$@"; else __root3_screen fzf; fi
  }
  ncdu() {
    for a; do case $a in -o*) command ncdu "$@"; return ;; esac; done
    if __root3_asked "$@"; then command ncdu "$@"; else __root3_screen ncdu; fi
  }
  tmux() {
    for a; do case $a in -d|-V) command tmux "$@"; return ;; esac; done
    case ${1:-new} in new*|a|at|att*) __root3_screen tmux ;; *) command tmux "$@" ;; esac
  }
  zi() { __root3_screen zi; }
fi

# What a Prompt has, by kind, each marked by whether it runs here, and what any one of them is (help NAME): otter
# (otter), not the shell's own help, which names its builtins alone.
help() { otter "$@"; }

# What a person reaches for and the root does not keep says so, and what is there instead: the root has no manuals
# (each program says how it is used, with --help), and its packages are its release's (apk info lists them): none
# is added in a Prompt, whose root is read-only.
man() {
  if [ "$LENGTH3_LANG" = ja ]; then echo "man: この root はマニュアルを持ちません。help ${1:-名前} がそれが何かを、${1:-プログラム} --help が使い方を、tldr ${1:-プログラム} がよくある使い方を言います" >&2
  else echo "man: the root keeps no manuals; help ${1:-NAME} says what it is, ${1:-a program} --help how it is used, and tldr ${1:-program} its common uses." >&2; fi
  return 1
}
apk() {
  case $1 in
    add|del|fix|upgrade|update|cache)
      if [ "$LENGTH3_LANG" = ja ]; then echo "apk: この root のパッケージはリリースのもので、Prompt の中では足せません（root は読み取り専用）。あるものは apk info で" >&2
      else echo "apk: the root's packages are its release's, and none is added in a Prompt (its root is read-only); apk info lists them." >&2; fi
      return 1 ;;
  esac
  command apk "$@"
}
